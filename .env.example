# Copy to .env and fill in only if you want to use a real LLM provider.
# The app, tests and eval all run fully offline with deterministic fakes
# when no key is configured.

# Optional: enables an OpenAI-backed LLM/embedder via LangChain when set.
OPENAI_API_KEY=

# Optional model overrides (used only when OPENAI_API_KEY is set).
SUPPORT_DESK_MODEL=gpt-4o-mini
SUPPORT_DESK_EMBEDDING_MODEL=text-embedding-3-small
